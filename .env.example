#
# Copy this file to .env and set the console's address. The local .env file is
# ignored by Git and read by tools/dev.sh, tools/dev.ps1 and Make (a variable
# set in the environment wins); keep application identity and release metadata
# in sce_sys/param.json.

# The PS5 to deploy to: its address and the FTP port (usually 2121).
PS5_HOST=192.168.1.100
FTP_PORT=2121

# Compile jobs (default: every CPU).
# BUILD_JOBS=8

# make deploy (the earlier interface): 1 prints what would be sent, sends nothing.
DEPLOY_DRY_RUN=0

# PACBREW_PACKAGES=sdl2 openssl
